<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Diagnostic fallback for machines where mspdbsrv.exe is already running
    with an incompatible version. This changes only compiler debug-info
    storage (/Z7 instead of /Zi); it does not change optimization or gameplay.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
</Project>
