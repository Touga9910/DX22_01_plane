{
  "schema_version": 3,
  "statistical_decision": {
    "enabled": true,
    "confidence_level": 0.95,
    "additional_batch_size": 10,
    "maximum_sample_count": 60
  },
  "diagnostics": {
    "failure_taxonomy": {
      "burst_damage_hp_ratio": 0.35,
      "long_battle_shot_multiplier": 1.5
    },
    "difficulty_spikes": {
      "minimum_samples_per_floor": 5,
      "failure_rate_delta": 0.15,
      "damage_ratio_delta": 0.20,
      "median_shots_delta": 3.0,
      "remaining_hp_ratio_drop": 0.20
    }
  },
  "minimum_sample_count": 30,
  "minimum_sample_count_by_stage_type": {
    "normal": 30,
    "midBoss": 15,
    "boss": 10
  },
  "boss_revaluation": {
    "minimum_reached_runs": 10
  },
  "adjustment_score_threshold": 60.0,
  "balanced_score_threshold": 80.0,
  "stage_type_targets": {
    "normal": {
      "metrics": {
        "clear_rate": { "min": 0.85, "max": 0.98, "tolerance": 0.25 },
        "median_shots": { "min": 3.0, "max": 5.0, "tolerance": 4.0 },
        "average_remaining_hp_ratio": { "min": 0.40, "max": 0.80, "tolerance": 0.40 }
      }
    },
    "midBoss": {
      "metrics": {
        "clear_rate": { "min": 0.70, "max": 0.90, "tolerance": 0.30 },
        "median_shots": { "min": 5.0, "max": 8.0, "tolerance": 5.0 },
        "average_remaining_hp_ratio": { "min": 0.20, "max": 0.60, "tolerance": 0.40 }
      }
    },
    "boss": {
      "metrics": {
        "clear_rate": { "min": 0.55, "max": 0.80, "tolerance": 0.35 },
        "median_shots": { "min": 7.0, "max": 12.0, "tolerance": 7.0 },
        "average_remaining_hp_ratio": { "min": 0.10, "max": 0.50, "tolerance": 0.40 }
      }
    }
  },
  "run_targets": {
    "minimum_sample_count": 30,
    "default_profile": "intermediate",
    "metrics": {
      "first_boss_reach_rate": {
        "min": 0.35,
        "max": 0.65,
        "tolerance": 0.35,
        "weight": 0.30,
        "hard_gate": true,
        "difficulty_direction": "easier"
      },
      "first_boss_clear_rate": {
        "min": 0.20,
        "max": 0.50,
        "tolerance": 0.35,
        "weight": 0.20,
        "hard_gate": true,
        "difficulty_direction": "easier"
      },
      "second_boss_reach_rate": {
        "min": 0.08,
        "max": 0.30,
        "tolerance": 0.30,
        "weight": 0.15,
        "hard_gate": false,
        "difficulty_direction": "easier"
      },
      "median_reached_progress": {
        "min": 8.0,
        "max": 16.0,
        "tolerance": 10.0,
        "weight": 0.25,
        "hard_gate": true,
        "difficulty_direction": "easier"
      },
      "terminal_run_rate": {
        "min": 0.95,
        "max": 1.00,
        "tolerance": 0.25,
        "weight": 0.10,
        "hard_gate": true,
        "statistical_gate": false,
        "difficulty_direction": "neutral"
      }
    },
    "profile_overrides": {
      "beginner": {
        "metrics": {
          "first_boss_reach_rate": { "min": 0.20, "max": 0.45 },
          "first_boss_clear_rate": { "min": 0.10, "max": 0.30 },
          "second_boss_reach_rate": { "min": 0.02, "max": 0.15 },
          "median_reached_progress": { "min": 6.0, "max": 11.0 }
        }
      },
      "advanced": {
        "metrics": {
          "first_boss_reach_rate": { "min": 0.55, "max": 0.85 },
          "first_boss_clear_rate": { "min": 0.35, "max": 0.70 },
          "second_boss_reach_rate": { "min": 0.20, "max": 0.50 },
          "median_reached_progress": { "min": 11.0, "max": 22.0 }
        }
      }
    }
  },
  "metrics": {
    "clear_rate": {
      "min": 0.65,
      "max": 0.80,
      "tolerance": 0.25,
      "weight": 0.40,
      "hard_gate": true
    },
    "median_shots": {
      "min": 4.0,
      "max": 7.0,
      "tolerance": 5.0,
      "weight": 0.25,
      "hard_gate": true
    },
    "average_remaining_hp_ratio": {
      "min": 0.30,
      "max": 0.65,
      "tolerance": 0.35,
      "weight": 0.15,
      "hard_gate": true
    },
    "no_hit_shot_rate": {
      "min": 0.00,
      "max": 0.20,
      "tolerance": 0.40,
      "weight": 0.10,
      "hard_gate": true
    },
    "average_collision_effect": {
      "min": 1.0,
      "max": 3.0,
      "tolerance": 3.0,
      "weight": 0.10,
      "hard_gate": true
    }
  }
}
